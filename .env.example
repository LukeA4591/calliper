# Copy to .env.local. Use your own Supabase project or `pnpm supabase status`.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:55431
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=replace-with-your-publishable-or-local-anon-key

# ForgeCheck's local PDF viewer, fixtures, and IndexedDB projects need no credentials.
# The Supabase values above are only required for the preserved /login and /ideas routes.

# OpenAI drawing extraction (server-only; never use NEXT_PUBLIC_ for this key).
AI_API_KEY=

# Optional image + structured-output model override.
AI_MODEL=gpt-4.1-mini
# Required outside localhost development: comma-separated verified Supabase user IDs.
AI_ALLOWED_USER_IDS=
