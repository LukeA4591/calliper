# Copy to .env.local. Use your own Supabase project or `pnpm supabase status`.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:55431
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=replace-with-your-publishable-or-local-anon-key

# Supabase is required for verified accounts, manufacturer profiles and owned analysis history.
# PDF/STEP files remain in account-scoped IndexedDB; the app does not upload them.

# OpenAI drawing extraction (server-only; never use NEXT_PUBLIC_ for this key).
AI_API_KEY=

# Optional image + structured-output model override.
AI_MODEL=gpt-6-astra

# Authentication email delivery (server/CLI only).
# Create a Resend account, verify a domain, then add a sending API key as the password.
# Leave password and sender blank until ready; default delivery stays in the local inbox.
# Enable with: pnpm email:configure smtp
# Apply with: pnpm supabase stop && pnpm db:start
SMTP_HOST=smtp.resend.com
SMTP_PORT=465
SMTP_USER=resend
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
